{
  "schemaVersion": 1,
  "name": "St. Paul's newsletter design tokens",
  "status": "canonical",
  "readableCopy": "newsletter-system/tokens.md",
  "rules": "docs/st-pauls-comprehensive-newsletter-template.md",
  "note": "Email clients cannot read CSS variables. These values are typed inline in each component; change a value here first, then update the components and the gallery check.",
  "color": {
    "core": {
      "navy": "#0A1C2C",
      "slateNavy": "#1E293B",
      "bodySlate": "#475569",
      "softSlate": "#64748B",
      "gold": "#D4AF37",
      "deepGold": "#B8860B",
      "lightGold": "#F0D98C",
      "cream": "#FDFBF7",
      "softBlue": "#EBF4F8",
      "white": "#FFFFFF"
    },
    "supporting": {
      "navyRaised": "#13293D",
      "onDarkBody": "#E2E8F0",
      "onDarkMuted": "#CBD5E1",
      "hairline": "#E5E7EB",
      "creamRule": "#E9DFC7"
    },
    "usage": {
      "labelOnLight": "#0A1C2C (with a gold rule beside it)",
      "labelOnDark": "#F0D98C",
      "headingOnLight": "#0A1C2C",
      "headingOnDark": "#FFFFFF",
      "bodyOnLight": "#475569",
      "bodyOnDark": "#E2E8F0",
      "emphasisOnLight": "#B8860B, weight 800",
      "emphasisOnDark": "#F0D98C, weight 700",
      "buttonOnLight": "navy fill, white text",
      "buttonOnDark": "gold #D4AF37 fill, navy text"
    },
    "notAllowed": ["teal #007A8A", "#DAA017", "#9C6A08", "#0D1B2A", "#FAF7F1"]
  },
  "font": {
    "display": "'Lora', Georgia, 'Times New Roman', serif",
    "body": "'Inter', Arial, Helvetica, sans-serif",
    "outlookDisplay": "Georgia, 'Times New Roman', serif (via .c-serif)",
    "outlookBody": "Arial, Helvetica, sans-serif",
    "notAllowed": ["Playfair Display", "Source Sans 3"]
  },
  "type": {
    "heroTitle": { "desktop": "60-64px / 66-70px, 700", "mobile": "40px / 46px", "class": "c-hero-title" },
    "display": { "desktop": "44-56px / 50-62px, 700", "mobile": "32px / 38px", "class": "c-display" },
    "h2": { "desktop": "40-42px / 46-48px, 700", "mobile": "28px / 34px", "class": "c-h2" },
    "h3": { "desktop": "30px / 36px, 700", "mobile": "23px / 30px", "class": "c-h3" },
    "lead": { "desktop": "22-24px / 32-36px, Lora 500 (often italic)", "mobile": "19px / 30px", "class": "c-lead" },
    "quote": { "desktop": "26-32px / 36-44px, Lora italic", "mobile": "22px / 32px", "class": "c-quote" },
    "body": { "desktop": "19px / 32px, Inter 400", "mobile": "18px / 30px", "class": "c-body" },
    "eyebrow": { "all": "14px / 20px, Inter 800, letter-spacing 0.18em, uppercase" },
    "caption": { "all": "14px / 21px, Inter 400, #64748B" }
  },
  "space": {
    "canvas": "1100px max width",
    "contentWidth": "1004px (1100 minus 48px gutters)",
    "gutter": { "desktop": "48px", "mobile": "16px", "class": "c-gutter" },
    "band": { "desktop": "48-64px top and bottom", "mobile": "36px", "class": "c-band" },
    "cardPadding": { "desktop": "40-52px", "mobile": "28px 22px", "class": "c-pad" },
    "columnGap": "24-32px each side of a split"
  },
  "radius": {
    "card": "28px",
    "image": "18-24px",
    "panel": "32-36px",
    "button": "999px (pill)",
    "note": "Outlook desktop ignores border-radius and shows square corners."
  },
  "rule": {
    "goldBand": "6px #D4AF37 full-width row between navy and light bands",
    "eyebrowRule": "32 x 3px #D4AF37 cell beside a label",
    "cardTop": "6px solid #D4AF37 border-top on featured cards"
  },
  "image": {
    "brandMark": "88px (64px in masthead-split)",
    "sectionIcon": "72px (60px on mobile)",
    "landscapeFull": "1004px (1002px inside a bordered card); source at least 1004px wide",
    "split": "478px; source at least 478px wide, ideally 956px",
    "squareFeature": "410px (spotlight feature), 520px (spotlight showcase), 340px (navy card), 280px (badge)",
    "portrait": "400px (greetings), 360px (our mission), 340px (portrait feature)",
    "mobileMax": { "portrait": "300px", "square": "320px", "landscape": "100% width" },
    "fileSize": "Keep each email illustration under 300 KB (JPG for flat art without transparency)."
  }
}
